<Window x:Class="PureX.Views.ToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PureX.ViewModels"
        Title="工具箱" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:ToolboxViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <!-- 音频提取 -->
            <TabItem Header="音频提取">
                <StackPanel Margin="15">
                    <TextBlock Text="从视频中提取音频" FontSize="14" Foreground="#424242" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输入文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding AudioExtractInput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectAudioExtractInputCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding AudioExtractOutput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectAudioExtractOutputCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="音频格式：" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AudioFormats}" 
                                  SelectedItem="{Binding SelectedAudioFormat}"/>
                        <TextBlock Grid.Column="2" Text="比特率：" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding AudioBitrates}" 
                                  SelectedItem="{Binding AudioBitrate}"/>
                    </Grid>

                    <Button Content="提取音频" Style="{StaticResource ToolButton}"
                            Command="{Binding ExtractAudioCommand}"
                            HorizontalAlignment="Left" Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 音频合成 -->
            <TabItem Header="音频合成">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="合并多个音频文件" FontSize="14" Foreground="#424242" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding AudioMergeFiles}" 
                                 BorderBrush="#E0E0E0" Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="✕" 
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#9E9E9E"
                                                Command="{Binding DataContext.RemoveAudioMergeFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Column="1" Content="添加文件" Style="{StaticResource SelectButton}"
                                Command="{Binding AddAudioMergeFileCommand}" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding AudioMergeOutput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectAudioMergeOutputCommand}"/>
                    </Grid>

                    <Button Grid.Row="3" Content="合并音频" Style="{StaticResource ToolButton}"
                            Command="{Binding MergeAudioCommand}"
                            HorizontalAlignment="Left"/>
                </Grid>
            </TabItem>

            <!-- 格式修复 -->
            <TabItem Header="格式修复">
                <StackPanel Margin="15">
                    <TextBlock Text="修复损坏的媒体文件" FontSize="14" Foreground="#424242" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输入文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding RepairInput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectRepairInputCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding RepairOutput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectRepairOutputCommand}"/>
                    </Grid>

                    <TextBlock Text="提示：此功能可修复部分损坏的媒体文件索引，无法修复严重损坏的文件。"
                               Foreground="#9E9E9E" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <Button Content="修复文件" Style="{StaticResource ToolButton}"
                            Command="{Binding RepairFileCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <!-- 音视频裁剪 -->
            <TabItem Header="音视频裁剪">
                <StackPanel Margin="15">
                    <TextBlock Text="按时间裁剪音视频片段" FontSize="14" Foreground="#424242" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输入文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding TrimInput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectTrimInputCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding TrimOutput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectTrimOutputCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开始时间：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding TrimStartTime, StringFormat=hh\\:mm\\:ss}"/>
                        <TextBlock Grid.Column="2" Text="结束时间：" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Grid.Column="3" Text="{Binding TrimEndTime, StringFormat=hh\\:mm\\:ss}"/>
                    </Grid>

                    <TextBlock Text="时间格式：时:分:秒（如 00:01:30 表示1分30秒）"
                               Foreground="#9E9E9E" FontSize="11" Margin="0,0,0,20"/>

                    <Button Content="裁剪媒体" Style="{StaticResource ToolButton}"
                            Command="{Binding TrimMediaCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <!-- 音视频剪辑 -->
            <TabItem Header="音视频剪辑">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="合并多个音视频文件" FontSize="14" Foreground="#424242" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding MediaJoinFiles}" 
                                 BorderBrush="#E0E0E0" Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="✕" 
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#9E9E9E"
                                                Command="{Binding DataContext.RemoveMediaJoinFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Column="1" Content="添加文件" Style="{StaticResource SelectButton}"
                                Command="{Binding AddMediaJoinFileCommand}" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出文件：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding MediaJoinOutput}" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="选择" Style="{StaticResource SelectButton}"
                                Command="{Binding SelectMediaJoinOutputCommand}"/>
                    </Grid>

                    <Button Grid.Row="3" Content="合并媒体" Style="{StaticResource ToolButton}"
                            Command="{Binding JoinMediaCommand}"
                            HorizontalAlignment="Left"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ProgressBar Width="150" Height="4" Value="{Binding Progress}" Maximum="100"
                             Foreground="#4CAF50" Background="#E0E0E0"
                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="关闭" Style="{StaticResource SelectButton}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
