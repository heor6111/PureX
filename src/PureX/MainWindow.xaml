<Window x:Class="PureX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PureX"
        xmlns:models="clr-namespace:PureX.Models"
        mc:Ignorable="d"
        Title="PureX - 专业多媒体格式转换工具" Height="700" Width="950"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Closing="Window_Closing">
    
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="DropZoneStyle" TargetType="Border">
                <Setter Property="Background" Value="#F8F9FA"/>
                <Setter Property="BorderBrush" Value="#DEE2E6"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            
            <Style x:Key="DropZoneActiveStyle" TargetType="Border">
                <Setter Property="Background" Value="#E3F2FD"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2196F3"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1976D2"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#BDBDBD"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F44336"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#D32F2F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#616161"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FileListItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E3F2FD"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="FileConverter" FontSize="20" FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center"/>
                    <TextBlock Text="文件格式转换工具" FontSize="12" Foreground="#757575" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="#616161"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drop Zone -->
            <Border x:Name="DropZone" Grid.Row="0" Style="{StaticResource DropZoneStyle}" 
                    Height="100" Margin="0,0,0,15"
                    AllowDrop="True">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="拖拽文件到此处" FontSize="15" Foreground="#616161" HorizontalAlignment="Center"/>
                        <TextBlock Text="支持视频、音频、图片格式" FontSize="11" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="15" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddFilesCommand}"
                            IsEnabled="{Binding IsNotConverting}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="选择文件"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Progress Panel -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                    CornerRadius="4" Margin="0,0,0,15" Padding="15"
                    Visibility="{Binding IsConverting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" 
                                   FontSize="13" Foreground="#424242" VerticalAlignment="Center"/>
                        
                        <ProgressBar Grid.Column="1" Height="6" Margin="15,0"
                                     Value="{Binding TotalProgress}" Maximum="100"
                                     Foreground="#2196F3" Background="#E0E0E0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding SpeedText}" FontSize="12" Foreground="#757575" Margin="0,0,15,0"/>
                            <TextBlock Text="{Binding TimeRemainingText}" FontSize="12" Foreground="#757575"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="暂停" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PauseCommand}"
                                Visibility="{Binding CanPause, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,8,0"/>
                        <Button Content="继续" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ResumeCommand}"
                                Visibility="{Binding CanResume, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,8,0"/>
                        <Button Content="取消" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File List -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" 
                                CornerRadius="4,4,0,0" Padding="15,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="文件列表" FontWeight="Medium" Foreground="#424242"/>
                                    <Button Content="重试失败" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RetryAllCommand}"
                                            Padding="10,5"
                                            Margin="15,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="打开目录" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenOutputFolderCommand}"
                                            Padding="10,5"
                                            Margin="0,0,10,0"/>
                                    <Button Content="清空列表" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearFilesCommand}"
                                            Padding="10,5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding SelectedFile}"
                                 ItemContainerStyle="{StaticResource FileListItemStyle}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:FileItem">
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FileType}" 
                                                   FontSize="11" Foreground="White" Background="#2196F3"
                                                   Padding="8,3" Margin="0,0,10,0">
                                            <TextBlock.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MediaType}" Value="Video">
                                                            <Setter Property="Background" Value="#E91E63"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MediaType}" Value="Audio">
                                                            <Setter Property="Background" Value="#9C27B0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MediaType}" Value="Image">
                                                            <Setter Property="Background" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Resources>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="#9E9E9E"/>
                                                <TextBlock Text=" | " FontSize="11" Foreground="#BDBDBD" 
                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#F44336" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Format Selection ComboBox -->
                                        <ComboBox Grid.Column="2" Width="80" Height="26" Margin="10,0"
                                                  ItemsSource="{Binding AvailableFormats}"
                                                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  FontSize="11"
                                                  IsEnabled="{Binding Status, Converter={StaticResource PendingToBoolConverter}}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <ProgressBar Grid.Column="3" Width="60" Height="4" Margin="10,0"
                                                     Value="{Binding Progress}" Maximum="100"
                                                     Foreground="#4CAF50" Background="#E0E0E0"
                                                     Visibility="{Binding Status, Converter={StaticResource ConvertingToVisibilityConverter}}"/>

                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Converting">
                                                            <Setter Property="Foreground" Value="#2196F3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Resources>
                                        </TextBlock>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="重试" 
                                                    Width="40" Height="24"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="#E0E0E0"
                                                    Foreground="#616161"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Status, Converter={StaticResource FailedToVisibilityConverter}}"
                                                    Margin="0,0,5,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="✕" 
                                                    Width="24" Height="24"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#9E9E9E"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Output Settings -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="输出目录：" VerticalAlignment="Center" Foreground="#616161"/>
                    
                    <TextBlock Grid.Column="1" Text="{Binding OutputDirectory}" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="#424242" Margin="5,0"/>

                    <Button Grid.Column="2" Content="浏览..." 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectOutputDirectoryCommand}"
                            IsEnabled="{Binding IsNotConverting}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🔧 工具箱" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ToolboxButton_Click"
                        Margin="0,0,15,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="支持格式：" Foreground="#9E9E9E" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="视频(MP4/AVI/MKV/WebM) · 音频(MP3/WAV/AAC/FLAC) · 图片(JPG/PNG/WebP/GIF)" 
                               Foreground="#616161" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="高级设置" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AdvancedSettingsCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="开始转换" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ConvertCommand}"
                            MinWidth="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
